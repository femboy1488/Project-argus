{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argus Cluster",
  "version": "0.3.1",
  "identifier": "com.harkcluster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argus — Local Compute Cluster",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8080 https://huggingface.co; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://huggingface.co https://cdn-avatars.huggingface.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "category": "Utility",
    "shortDescription": "Argus — локальный кластер для LLM (GPU ПК + Android + Wi-Fi ноды)"
  }
}